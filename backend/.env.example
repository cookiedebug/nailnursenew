SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional. By default SQLite is stored in backend/instance/nailnurse.sqlite3.
# DATABASE_URL=sqlite:///C:/path/to/nailnurse.sqlite3
# Production on Vercel: set DATABASE_URL to your hosted PostgreSQL URL.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
